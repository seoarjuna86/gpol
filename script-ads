    height: 58px;
    margin: 0 auto 15px;
    border-radius: 50%;
    background: #e8f0fe;
    color: #1a73e8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
}

h2 {
    margin: 0 0 10px;
    color: #202124;
}

p {
    color: #f8f8f8;
    line-height: 1.5;
    margin: 0;
}

button {
    width: 100%;
    padding: 15px;
    margin-top: 22px;
    background: #1a73e8;
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 18px;
    cursor: pointer;
}

