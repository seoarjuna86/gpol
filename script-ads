/* Hilangkan logo badge reCAPTCHA v3 kanan bawah */
.grecaptcha-badge {
    visibility: hidden;
}
</style>
<style>
body {
    margin: 0;
    background-image: url('https://i.pinimg.com/736x/ea/60/b3/ea60b339f7968cd24f2275f3d5b694c7.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;

    font-family: Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}
/* ================================
   OVERLAY
================================ */
.promo-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 999999;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;
    box-sizing: border-box;

    background: rgba(0, 0, 0, 0.72);

    overflow-y: auto;
}


/* ================================
   CARD / KOLOM POPUP
================================ */
.promo-card {
    width: 100%;
    max-width: 400px;

    padding: 20px;

    box-sizing: border-box;

    background: linear-gradient(
        145deg,
        #242424,
        #151515
    );

    border: 1px solid rgba(255,255,255,0.12);

    border-radius: 22px;

    box-shadow:
        0 20px 60px rgba(0,0,0,0.75),
        inset 0 1px 0 rgba(255,255,255,0.08);

    text-align: center;

    animation: popupShow .35s ease;
}


/* ================================
   GAMBAR
================================ */
.promo-image {
    width: 100%;

    overflow: hidden;

    border-radius: 16px;

    background: #111;

    box-shadow:
        0 8px 25px rgba(0,0,0,0.55);
}

.promo-image img {
    display: block;

    width: 100%;
    height: auto;

    max-height: 380px;

    object-fit: cover;
}


/* ================================
   DESKRIPSI
================================ */
.promo-description {
    margin-top: 25px;

    color: #e8e8e8;

    font-size: 14px;
    line-height: 1.5;
}


/* ================================
   JUDUL
================================ */
.promo-title {
    margin-top: 12px;
    margin-bottom: 18px;

    color: #ffd900;

    font-size: 24px;
    font-weight: 800;

    text-transform: uppercase;
}


/* ================================
   BUTTON
================================ */
.promo-btn {
    display: block;

    width: 100%;

    margin-top: 12px;

    padding: 15px 10px;

    box-sizing: border-box;

    border-radius: 30px;

    color: #fff !important;

    font-size: 15px;
    font-weight: 700;

    text-decoration: none !important;

    transition:
        transform .2s ease,
        filter .2s ease;
}

.promo-btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
}

.promo-btn-red {
    background: #ff0050;

    box-shadow:
        0 5px 20px rgba(255,0,80,0.35);
}

.promo-btn-green {
    background: #20d665;

    box-shadow:
        0 5px 20px rgba(32,214,101,0.30);
}


/* ================================
   FOOTER
================================ */
.promo-footer {
    margin-top: 25px;

    color: #999;

    font-size: 11px;
}


/* ================================
   ANIMATION
================================ */
@keyframes popupShow {
    from {
        opacity: 0;
        transform: scale(.90) translateY(20px);
    }

    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}


/* ================================
   MOBILE
================================ */
@media (max-width: 480px) {

    .promo-overlay {
        padding: 14px;
    }

    .promo-card {
        max-width: 360px;
        padding: 16px;
        border-radius: 20px;
    }

    .promo-image img {
        max-height: 330px;
    }

    .promo-description {
        font-size: 13px;
        margin-top: 20px;
    }

    .promo-title {
        font-size: 22px;
    }

    .promo-btn {
        padding: 14px 8px;
        font-size: 14px;
    }
}
</style>
</head>

<body>

<!-- OVERLAY POPUP -->
<div id="promoModal" class="promo-overlay">

    <!-- KOLOM / CARD UTAMA -->
    <div class="promo-card">

        <!-- GAMBAR -->
        <div class="promo-image">
            <img src="https://i.gyazo.com/188f10a05296861d820905239d700f0c.png" alt="Promo">
        </div>

        <!-- TEKS -->
        <div class="promo-description">
            Akses Ke Toko Paling Best no 1 di Indonesia
        </div>

        <div class="promo-title">
            RAJA700
        </div>

        <!-- TOMBOL -->
    <button id="verifyBtn" onclick="submitCaptcha()" class="promo-btn promo-btn-red">
        AMBIL PROMOSI SEKARANG
    </button>

    <button id="verifyBtn" onclick="submitCaptcha()" class="promo-btn promo-btn-green">
        HUBUNGI TOKO SEKARANG
    </button>

        <!-- FOOTER -->
        <div class="promo-footer">
            © 2022–2026 RAJA700 | TOKO RAJA700
        </div>

    </div>

</div>

<script>
const RECAPTCHA_SITE_KEY = "6Lc7ZoYtAAAAAGUjjtEdyveONIhoQYIKPX76Dotx";
const RECAPTCHA_ACTION = "verify";

function getTrackingParams() {
    const currentParams = new URLSearchParams(window.location.search);

    const allowedParams = [
        "ttclid",
        "click_id",
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_content",
        "utm_term",
        "utm_id",
        "campaign_id",
        "adgroup_id",
        "ad_id"
    ];

    const params = {};

    allowedParams.forEach(key => {
        const value = currentParams.get(key);
        if (value) {
            params[key] = value;
        }
    });

    return params;
}

function setButtonLoading(isLoading) {
    const btn = document.getElementById("verifyBtn");
    btn.disabled = isLoading;
    btn.innerText = isLoading ? "Memverifikasi..." : "Melanjutkan";
}

function submitCaptcha() {
    if (!window.grecaptcha) {
        alert("reCAPTCHA belum siap. Silakan refresh halaman.");
        return;
    }

    setButtonLoading(true);

    grecaptcha.ready(function () {
        grecaptcha.execute(RECAPTCHA_SITE_KEY, { action: RECAPTCHA_ACTION })
            .then(function (token) {
                return fetch("/verify", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        token: token,
                        params: getTrackingParams()
                    })
                });
            })
            .then(function (res) {
                return res.json();
            })
            .then(function (data) {
                if (data.success && data.redirect) {
                    window.location.href = data.redirect;
                    return;
                }

                alert("Verifikasi gagal. Silakan coba lagi.");
                setButtonLoading(false);
            })
            .catch(function () {
                alert("Terjadi kesalahan server.");
                setButtonLoading(false);
            });
    });
}
</script>

</body>
</html>
