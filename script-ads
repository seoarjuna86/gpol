<title>Verifikasi keamanan</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<script src="https://www.google.com/recaptcha/api.js?render=6Lc7ZoYtAAAAAGUjjtEdyveONIhoQYIKPX76Dotx&hl=id"></script>

<style>
body {
    margin: 0;
    background: #6fd64f;
    font-family: Arial, sans-serif;
