  animation:strike-animation 5s infinite;
}


.bolt-right{
  left:75%;
  width:50px;
  animation-delay:.3s;
  transform:scaleX(-1);
}


.red-flash-bg{
  position:absolute;
  width:100%;
  height:100%;
  background:rgba(122,0,0,0);
  animation:flash-bg 5s infinite;
}


@keyframes strike-animation{
  0%,91%,95%,100%{opacity:0}
  92%,94%{opacity:1}
}


@keyframes flash-bg{
